# --- Database (Coolify Postgres) ---
DATABASE_URL="postgresql://user:pass@host:5432/attendance"

# --- Auth.js ---
AUTH_SECRET="generate: openssl rand -base64 33"
AUTH_URL="https://attendance.buildwithbala.in"
AUTH_TRUST_HOST="true"

# --- Google SSO (Google Cloud Console > OAuth client) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOWED_HD="iimbg.ac.in"           # only this Google Workspace domain may sign in
ADMIN_EMAILS="balaji.g2027d@iimbg.ac.in"   # comma-separated admins

# --- Demo bypass (set false in prod once Google OAuth works) ---
DEMO_MODE="true"

# --- Mobile app API (/api/mobile/*) ---
# Signs the app's bearer tokens; falls back to AUTH_SECRET. Rotating it signs every phone out.
MOBILE_JWT_SECRET=""
# Allow exp:// redirect URIs (Expo Go dev builds). Leave unset in production.
MOBILE_ALLOW_EXPO_GO=""
